{
  "name": "shittytees",
  "version": "0.1.0",
  "description": "Print-on-demand apparel store for questionable taste",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components data lib tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "printful:inspect": "tsx scripts/inspect-printful-store.ts",
    "printful:sync": "tsx scripts/sync-printful.ts",
    "db:migrate": "tsx scripts/run-db-migrations.ts",
    "catalog:migrate": "tsx scripts/migrate-products-to-database.ts --apply",
    "orders:migrate": "tsx scripts/migrate-file-orders-to-database.ts",
    "product:publish": "tsx scripts/product-publish.ts",
    "product:archive": "tsx scripts/product-archive.ts",
    "product:disable": "tsx scripts/product-disable.ts",
    "product:images": "tsx scripts/product-images.ts",
    "products:report": "tsx scripts/products-report.ts",
    "products:review": "tsx scripts/products-review.ts"
  },
  "dependencies": {
    "next": "16.2.9",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^17.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
